# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Build & Compilation
dist/
build/
*.tsbuildinfo
.cache/

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

*.pem
*.key
*.cert
*.pfx
*.p12
*.crt

