# ==============================================================================
# Inkviz — Production-Grade Git Ignore (Root)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credentials, Environment Variables & API Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret files, keys, and specific token dumps
db_pass
secrets/
credentials.json
token.txt
tokens.json
*.pem
*.key
*.cert
*.pfx
*.p12
*.crt

# Cookies, auth session dumps & manual scripts with API keys
cookies.txt
qa_cookies.txt
*.cookie
sync-postman.js
fix_types*.js
backend/fix_types*.js

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers (Installed automatically by cloud build)
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
*.tgz

# ------------------------------------------------------------------------------
# 3. Build Artifacts & Caches (Compiled on cloud server via npm run build)
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
backend/dist/
*.tsbuildinfo
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Testing, Coverage & Scratch Directories
# ------------------------------------------------------------------------------
coverage/
backend/coverage/
.nyc_output/
scratch/
backend/scratch/

# ------------------------------------------------------------------------------
# 6. Generated Client Documents & Export Artifacts
# ------------------------------------------------------------------------------
*.pdf
invoice_curl.pdf
qa_invoice.pdf
*.csv
*.xlsx
inkviz-export*.json

# ------------------------------------------------------------------------------
# 7. Databases & Local Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump

# ------------------------------------------------------------------------------
# 8. OS & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# AI Assistant & IDE Internal Artifacts
.antigravity/

# ------------------------------------------------------------------------------
# 9. Whitelist Critical Source Directories (Never ignore source code)
# ------------------------------------------------------------------------------
!backend/src/**
!frontend/src/**
!frontend/app/**
!frontend/components/**
