# ==============================================================================
# Inkviz — Enterprise Production-Grade Git Ignore (Root)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Configuration (CRITICAL - DO NOT REMOVE)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env*.local

# Allow safe example environment template files only
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. Security Credentials, Keys, Certificates & Tokens
# ------------------------------------------------------------------------------
*.pem
*.key
*.cert
*.pfx
*.p12
*.crt
*.csr
*.cer
*.der
*.id_rsa
id_rsa*
*.pub
*.keystore
*.jks
credentials.json
client_secret*.json
service-account*.json
gcp-key*.json
aws-credentials*
firebase-adminsdk*.json
secrets/
backend/secrets/

# Passwords, tokens & cookie session dumps
db_pass
passwords.txt
token.txt
tokens.json
cookies.txt
qa_cookies.txt
*.cookie

# ------------------------------------------------------------------------------
# 3. Customer Data, Uploads, Storage & Generated PDFs (PII Protection)
# ------------------------------------------------------------------------------
*.pdf
invoice_curl.pdf
qa_invoice.pdf
*.csv
*.xlsx
*.xls
inkviz-export*.json
uploads/
backend/uploads/
frontend/uploads/
exports/
backend/exports/
temp/
tmp/
backend/temp/
backend/tmp/

# ------------------------------------------------------------------------------
# 4. Databases, Local Dumps & Storage Files
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
dump/
data/
*.rdb
*.seed

# ------------------------------------------------------------------------------
# 5. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
*.tgz

# ------------------------------------------------------------------------------
# 6. Build Outputs, Deployments & Framework Caches
# ------------------------------------------------------------------------------
dist/
backend/dist/
build/
out/
frontend/out/
.next/
frontend/.next/
.vercel/
frontend/.vercel/
*.tsbuildinfo
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 7. Diagnostic Scripts, One-off Scaffolds & Scratch Artifacts
# ------------------------------------------------------------------------------
scratch/
backend/scratch/
test-routes.js
scaffold*.js
sync-postman.js
fix_types*.js
backend/fix_types*.js
test_all_endpoints.js

# ------------------------------------------------------------------------------
# 8. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
backend/logs/
frontend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 9. Test Results & Code Coverage
# ------------------------------------------------------------------------------
coverage/
backend/coverage/
frontend/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 10. OS & Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 11. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 12. AI Tooling & Internal IDE Artifacts
# ------------------------------------------------------------------------------
.gemini/
.antigravity/

# ------------------------------------------------------------------------------
# 13. Whitelist Critical Source Directories (Never ignore source code)
# ------------------------------------------------------------------------------
!backend/src/**
!frontend/src/**
!frontend/public/**
